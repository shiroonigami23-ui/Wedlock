{
  "name": "wedlock-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "Wedlock desktop wrapper",
  "main": "main.js",
  "scripts": {
    "dist": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^31.2.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.wedlock.desktop",
    "productName": "Wedlock",
    "files": [
      "main.js"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "portable"
      ]
    }
  }
}

